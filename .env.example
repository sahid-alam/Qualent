# Database. App runtime connects as app_user, which cannot bypass row-level security.
# Web on Supabase: transaction pooler.
DATABASE_URL=
# Migration role with schema rights. Used by `npm run db:migrate` only.
MIGRATE_DATABASE_URL=
# Tests: a throwaway local Postgres 17 database, as a superuser.
TEST_DATABASE_URL=

APP_URL=
# Encrypts connection tokens. `openssl rand -base64 32`
SECRET_KEY=
# Guards /api/cron/tick. Must match supabase/cron.sql.
CRON_SECRET=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Meta
META_APP_SECRET=
META_VERIFY_TOKEN=

# Telegram. Features skip safely while these are empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
OPS_TELEGRAM_CHAT_ID=

# AI keys are named per model in the ai_models table (api_key_env).
# With no model configured, leads simply stay unscored.

# Local development only: sign in as a seeded person, with no Supabase project.
# Ignored in production, and ignored whenever Supabase is configured.
DEV_AUTH=
