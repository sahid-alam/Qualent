    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-setup.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "make-admin": "node --env-file-if-exists=.env.local scripts/make-admin.ts",
    "telegram:setup": "node --env-file-if-exists=.env.local scripts/telegram-setup.ts"
